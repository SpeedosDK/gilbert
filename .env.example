# development or production
NODE_ENV=
HOST=
PORT=
# link til mongodb
DB_URL=
# webtoken secret noget langt og tilfældigt
JWT_SECRET=
# refreshtoken secret noget langt og tilfældigt
REFRESH_TOKEN_SECRET=noget_meget_langt_og_tilfældigt
# Når man opdaterer terms
TERMS_VERSION=1.0.0
# mailservice
MAIL_USER=
MAIL_PASSWORD=
# email secret er noget langt og tilfældigt
EMAIL_SECRET=
# link til frontend
FRONTEND_URL=
# reset secret til password, noget langt og tilfældigt
PASSWORD_RESET_SECRET=
# backend url
BASE_URL=
# Strip keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Shipmondo Credentials (Hentes under din profil hos Shipmondo)
# Production
SHIPMONDO_API_USER=xxxx
SHIPMONDO_API_KEY=xxxx

# Sandbox
SHIPMONDO_API_USER_SANDBOX=
SHIPMONDO_API_KEY_SANDBOX=


# Standard fragtindstillinger
# (Ændres i forhold til Shipmondo aftale)
SHIPMONDO_CARRIER_CODE=dao
SHIPMONDO_PRODUCT_CODE=DAO_STH
SHIPMONDO_SERVICE_ID=1

# Admin notifikationer (Hvis fragt fejler, sender systemet en mail herhen)
ADMIN_EMAIL=